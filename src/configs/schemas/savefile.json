{
  "type": "object",
  "properties": {
    "gameVersion": {
      "type": "string",
      "description": "Game version",
      "enum": ["0.4.0"]
    },
    "scenario": {
      "type": "object",
      "description": "Scenario state",
      "properties": {
        "currentScenario": {
          "type": "string",
          "description": "Current scenario"
        },
        "storyEvents": {
          "type": "object",
          "description": "Story events state",
          "properties": {
            "visitedAllEvents": {
              "type": "array",
              "description": "All visited events, including those in past replications",
              "items": {
                "type": "string",
                "description": "Visited event",
                "minLength": 1
              }
            },
            "visitedScenarioEvents": {
              "type": "array",
              "description": "All visited events in this replication",
              "items": {
                "type": "string",
                "description": "Visited event",
                "minLength": 1
              }
            }
          },
          "required": ["visitedAllEvents", "visitedScenarioEvents"]
        }
      },
      "required": ["currentScenario", "storyEvents"]
    },
    "faction": {
      "type": "object",
      "description": "Faction state",
      "properties": {
        "joiningFactionAvailable": {
          "type": "boolean",
          "description": "Are factions available to be joined"
        },
        "currentFaction": {
          "type": "string",
          "description": "Currently joined faction",
          "minLength": 1
        },
        "factionsList": {
          "type": "array",
          "description": "Factions available to join",
          "items": {
            "type": "string",
            "description": "Faction name",
            "minLength": 1
          }
        }
      },
      "required": ["joiningFactionAvailable", "currentFaction", "factionsList"]
    },
    "unlock": {
      "type": "object",
      "description": "Unlock state",
      "properties": {
        "milestones": {
          "type": "object",
          "description": "Milestones",
          "properties": {
            "reachedMilestones": {
              "type": "array",
              "description": "Reached milestones",
              "items": {
                "$ref": "./common/milestone.json",
                "description": "Reached milestone"
              }
            }
          },
          "required": ["reachedMilestones"]
        },
        "items": {
          "type": "object",
          "description": "Items",
          "properties": {
            "programs": {
              "type": "object",
              "description": "Programs",
              "properties": {
                "designs": {
                  "type": "object",
                  "description": "Programs designs",
                  "additionalProperties": {
                    "type": "integer",
                    "description": "Design tier",
                    "minimum": 0
                  },
                  "propertyNames": {
                    "$ref": "./common/program-name.json"
                  }
                }
              },
              "required": ["designs"]
            },
            "cloneTemplates": {
              "type": "object",
              "description": "Clone templates",
              "properties": {
                "designs": {
                  "type": "object",
                  "description": "Clone templates designs",
                  "additionalProperties": {
                    "type": "integer",
                    "description": "Design tier",
                    "minimum": 0
                  }
                }
              },
              "required": ["designs"]
            }
          },
          "required": ["programs", "cloneTemplates"]
        },
        "activities": {
          "type": "object",
          "description": "Activities",
          "properties": {
            "sidejobs": {
              "type": "object",
              "description": "Sidejobs",
              "properties": {
                "unlockedActivities": {
                  "type": "array",
                  "description": "Unlocked sidejobs",
                  "items": {
                    "type": "string",
                    "description": "Sidejob",
                    "minLength": 1
                  }
                }
              },
              "required": ["unlockedActivities"]
            },
            "contracts": {
              "type": "object",
              "description": "Contracts",
              "properties": {
                "unlockedActivities": {
                  "type": "array",
                  "description": "Unlocked contracts",
                  "items": {
                    "type": "string",
                    "description": "Contracts",
                    "minLength": 1
                  }
                }
              },
              "required": ["unlockedActivities"]
            }
          },
          "required": ["sidejobs", "contracts"]
        }
      },
      "required": ["milestones", "items", "activities"]
    },
    "global": {
      "type": "object",
      "description": "Global state",
      "properties": {
        "randomSeed": {
          "type": "string",
          "description": "Random seed",
          "minLength": 1
        },
        "randomShift": {
          "type": "string",
          "description": "Random shift",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "description": "Run ID",
          "minLength": 1
        },
        "gameSpeed": {
          "type": "integer",
          "description": "Game speed state, 0 - pause, 1 - normal, 2 - fast",
          "minimum": 0,
          "maximum": 2
        },
        "money": {
          "type": "object",
          "description": "Money",
          "properties": {
            "money": {
              "type": "number",
              "description": "Money value",
              "minimum": 0
            },
            "income": {
              "type": "object",
              "description": "Money income values",
              "additionalProperties": {
                "type": "number",
                "description": "Income value",
                "minimum": 0
              },
              "propertyNames": { "enum": ["program", "sidejob", "primaryActivity"] }
            },
            "expenses": {
              "type": "object",
              "description": "Money expenses values",
              "additionalProperties": {
                "type": "number",
                "description": "Expenses value",
                "minimum": 0
              },
              "propertyNames": { "enum": ["mainframePrograms", "mainframeHardware", "clones"] }
            }
          },
          "required": ["money", "income", "expenses"]
        },
        "time": {
          "type": "object",
          "description": "Time",
          "properties": {
            "lastUpdateTime": {
              "type": "number",
              "description": "Last update timestamp",
              "minimum": 0
            },
            "accumulatedTime": {
              "type": "number",
              "description": "Accumulated time",
              "minimum": 0
            },
            "gameTime": {
              "type": "number",
              "description": "Game time after last replication",
              "minimum": 0
            },
            "gameTimeTotal": {
              "type": "number",
              "description": "Total game time",
              "minimum": 0
            }
          },
          "required": ["lastUpdateTime", "accumulatedTime", "gameTime", "gameTimeTotal"]
        },
        "development": {
          "type": "object",
          "description": "Development",
          "properties": {
            "points": {
              "type": "number",
              "description": "Development points",
              "minimum": 0
            },
            "income": {
              "type": "object",
              "description": "Development income",
              "additionalProperties": {
                "type": "number",
                "description": "Development income value",
                "minimum": 0
              },
              "propertyNames": { "enum": ["program", "sidejob", "primaryActivity"] }
            }
          },
          "required": ["points", "income"]
        },
        "connectivity": {
          "type": "object",
          "description": "Connectivity",
          "properties": {
            "pointsByProgram": {
              "type": "number",
              "description": "Points by programs",
              "minimum": 0
            }
          },
          "required": ["pointsByProgram"]
        },
        "multipliers": {
          "type": "object",
          "description": "Cost multipliers",
          "additionalProperties": {
            "type": "object",
            "description": "Cost multiplier",
            "properties": {
              "pointsByProgram": {
                "type": "number",
                "description": "Points by programs",
                "minimum": 0
              }
            },
            "required": ["pointsByProgram"]
          },
          "propertyNames": { "enum": ["codeBase", "computationalBase"] },
          "required": ["codeBase", "computationalBase"]
        },
        "rewards": {
          "type": "object",
          "description": "Rewards",
          "properties": {
            "pointsByProgram": {
              "type": "number",
              "description": "Points by programs",
              "minimum": 0
            }
          },
          "required": ["pointsByProgram"]
        }
      },
      "required": [
        "randomSeed",
        "randomShift",
        "runId",
        "gameSpeed",
        "money",
        "time",
        "development",
        "connectivity",
        "multipliers",
        "rewards"
      ]
    },
    "settings": {
      "type": "object",
      "description": "Settings state",
      "properties": {
        "language": {
          "type": "string",
          "description": "Language",
          "enum": ["en", "ru"]
        },
        "theme": {
          "type": "string",
          "description": "Theme",
          "enum": ["light", "dark"]
        },
        "messageLogSize": {
          "type": "integer",
          "description": "Max amount of message log stored messages",
          "minimum": 1
        },
        "toastDuration": {
          "type": "number",
          "description": "Duration of toast messages (ms)",
          "minimum": 0
        },
        "updateInterval": {
          "type": "number",
          "description": "Interval between ticks (ms)",
          "minimum": 1
        },
        "autosaveEnabledOnHide": {
          "type": "boolean",
          "description": "Is autosave enabled on closing or hiding tab"
        },
        "autosaveInterval": {
          "type": "number",
          "description": "Autosave interval (ms)",
          "minimum": 1
        },
        "fastSpeedMultiplier": {
          "type": "integer",
          "description": "Game speed multiplier on fast mode",
          "minimum": 2
        },
        "maxUpdatesPerTick": {
          "type": "integer",
          "description": "Max amount of updates per tick",
          "minimum": 2
        },
        "longNumberFormat": {
          "type": "string",
          "description": "Long number format",
          "enum": ["short", "long", "scientific", "engineering"]
        },
        "enabledMessageEvents": {
          "type": "array",
          "description": "Enabled messages for events",
          "items": {
            "type": "string",
            "description": "Message event",
            "enum": [
              "gameStarted",
              "gameSaved",
              "fastForwarded",
              "levelReached",
              "performanceUpgraded",
              "coresUpgraded",
              "ramUpgraded",
              "programPurchased",
              "processStarted",
              "processDeleted",
              "displayedProcessesDeleted",
              "clonePurchased",
              "cloneLevelUpgraded",
              "cloneDeleted",
              "displayedClonesDeleted",
              "cloneLevelReached",
              "cloneRenamed",
              "cloneReplaced",
              "sidejobAssigned",
              "sidejobCancelled",
              "displayedSidejobsCancelled",
              "contractAssigned",
              "contractAssignmentRemoved",
              "displayedContractAssignmentsRemoved",
              "primaryActivityAdded",
              "primaryActivityFinished",
              "primaryActivityCancelled",
              "displayedPrimaryActivitiesCancelled",
              "districtTierIncreased"
            ]
          }
        },
        "enabledGameAlerts": {
          "type": "array",
          "description": "Enabled game alerts",
          "items": {
            "type": "string",
            "description": "Game alert",
            "enum": [
              "saveImport",
              "saveDelete",
              "clearMessages",
              "fastForward",
              "unassignHotkeys",
              "restoreDefaultHotkeys",
              "restoreDefaultSettings",
              "joinFaction",
              "purchaseProgramOverwrite",
              "processDelete",
              "processReplace",
              "deleteDisplayedProcesses",
              "cloneDelete",
              "cloneReplace",
              "deleteDisplayedClones",
              "sidejobCancel",
              "cancelDisplayedSidejobs",
              "replaceSidejob",
              "contractAssignmentCancel",
              "cancelDisplayedContractAssignments",
              "replaceContractAssignment",
              "cancelDisplayedPrimaryActivities",
              "cancelPrimaryActivity"
            ]
          }
        },
        "enabledNotificationTypes": {
          "type": "array",
          "description": "Enabled notification types",
          "items": {
            "type": "string",
            "description": "Notification type",
            "enum": [
              "storyEvent",
              "milestoneUnlocked",
              "timeAccumulated",
              "activityUnlocked",
              "designUnlocked",
              "factionsAvailable",
              "factionJoined",
              "districtContested",
              "districtCaptured"
            ]
          }
        },
        "hotkeys": {
          "$ref": "./common/hotkeys.json"
        }
      },
      "required": [
        "language",
        "theme",
        "messageLogSize",
        "toastDuration",
        "updateInterval",
        "autosaveEnabledOnHide",
        "autosaveInterval",
        "fastSpeedMultiplier",
        "maxUpdatesPerTick",
        "longNumberFormat",
        "enabledMessageEvents",
        "enabledGameAlerts",
        "enabledNotificationTypes",
        "hotkeys"
      ]
    },
    "clones": {
      "type": "object",
      "description": "Clones state",
      "properties": {
        "ownedClones": {
          "type": "object",
          "description": "Owned clones",
          "properties": {
            "clones": {
              "type": "array",
              "description": "Clones list",
              "items": {
                "type": "object",
                "description": "Clone",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Clone ID",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "description": "Clone name",
                    "minLength": 1
                  },
                  "templateName": {
                    "type": "string",
                    "description": "Clone template name",
                    "minLength": 1
                  },
                  "experience": {
                    "type": "number",
                    "description": "Clone experience",
                    "minimum": 0
                  },
                  "level": {
                    "type": "number",
                    "description": "Clone level",
                    "minimum": 0
                  },
                  "tier": {
                    "type": "number",
                    "description": "Clone tier",
                    "minimum": 0
                  },
                  "autoUpgradeEnabled": {
                    "type": "boolean",
                    "description": "Is autoupgrade enabled"
                  }
                },
                "required": ["id", "name", "templateName", "experience", "level", "tier", "autoUpgradeEnabled"]
              }
            }
          },
          "required": ["clones"]
        }
      },
      "required": ["ownedClones"]
    }
  },
  "required": ["gameVersion", "scenario", "faction", "unlock", "global", "settings", "clones"]
}
